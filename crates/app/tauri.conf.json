{
  "productName": "Agent Pad",
  "identifier": "com.agentpad.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "pad",
        "title": "Agent Pad",
        "width": 560,
        "height": 620,
        "minWidth": 380,
        "minHeight": 320,
        "alwaysOnTop": false,
        "dragDropEnabled": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
